{% comment %}
  Rivu Photo Gallery — Pro
  Add via: Customize -> Add section -> Apps -> Rivu Photo Gallery
  A wall of customer photos. Clicking one opens the full review with a link
  back to the product. Works on any page.
{% endcomment %}

<div
  data-rivu-showcase
  data-shop="{{ shop.permanent_domain }}"
  data-api-base="https://rivu-one.vercel.app"
  data-layout="gallery"
  data-heading="{{ block.settings.heading | escape }}"
  data-heading-align="{{ block.settings.heading_align }}"
  data-caption="{{ block.settings.caption | escape }}"
  data-limit="{{ block.settings.limit }}"
  data-min-rating="{{ block.settings.min_rating }}"
  data-with-media="{{ block.settings.photos_only }}"
  data-columns="{{ block.settings.columns }}"
  data-star-style="{{ block.settings.star_style }}"
  data-show-verified="{{ block.settings.show_verified }}"
  data-max-width="{{ block.settings.max_width }}"
  data-star-color="{{ block.settings.star_color }}"
  data-card-bg="{{ block.settings.card_bg }}"
  data-text-color="{{ block.settings.text_color }}"
  data-radius="{{ block.settings.radius }}"
  style="margin:{{ block.settings.spacing }}px 0;"
  {{ block.shopify_attributes }}
></div>
<script src="{{ 'rivu-showcase.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Rivu Photo Gallery",
  "target": "section",
  "settings": [
    { "type": "paragraph", "content": "Pro plan. Clicking a photo opens the full review with a link to the product." },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to hide the heading." },
    { "type": "text", "id": "caption", "label": "Caption below" },
    { "type": "range", "id": "limit", "label": "Photos to show", "min": 3, "max": 50, "step": 1, "default": 18 },
    { "type": "range", "id": "min_rating", "label": "Minimum rating", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "photos_only", "label": "Only reviews with a photo or video", "default": true, "info": "Turn off to include text-only reviews in the wall." },
    { "type": "checkbox", "id": "show_verified", "label": "Show \"Verified\" badge", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 40, "default": 1280, "unit": "px", "info": "0 = full width of your theme." },
    { "type": "range", "id": "spacing", "label": "Space above and below", "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "default": 10, "unit": "px" },

    { "type": "header", "content": "Style" },
    {
      "type": "select", "id": "star_style", "label": "Star shape",
      "options": [
        { "value": "star", "label": "Classic star" },
        { "value": "square", "label": "Solid square" }
      ],
      "default": "star"
    },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#f5b400" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a1a1a" }
  ]
}
{% endschema %}
