{% comment %}
  Rivu Testimonials
  Add via: Customize -> Add section -> Apps -> Rivu Testimonials
  Two styles: a rating strip (verdict + stars beside scrolling reviews, the
  layout review platforms use), or centred pull-quotes. Works on any page.
{% endcomment %}

<div
  data-rivu-showcase
  data-shop="{{ shop.permanent_domain }}"
  data-api-base="https://rivu-one.vercel.app"
  data-layout="{{ block.settings.style }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-heading-align="{{ block.settings.heading_align }}"
  data-verdict-text="{{ block.settings.verdict_text | escape }}"
  data-badge-text="{{ block.settings.count_text | escape }}"
  data-caption="{{ block.settings.caption | escape }}"
  data-limit="{{ block.settings.limit }}"
  data-min-rating="{{ block.settings.min_rating }}"
  data-clamp-lines="{{ block.settings.clamp_lines }}"
  data-compact-width="{{ block.settings.compact_width }}"
  data-star-style="{{ block.settings.star_style }}"
  data-underline-count="{{ block.settings.underline_count }}"
  data-show-verified="{{ block.settings.show_verified }}"
  data-show-arrows="{{ block.settings.show_arrows }}"
  data-arrow-style="{{ block.settings.arrow_style }}"
  data-max-width="{{ block.settings.max_width }}"
  data-star-color="{{ block.settings.star_color }}"
  data-card-bg="{{ block.settings.card_bg }}"
  data-text-color="{{ block.settings.text_color }}"
  data-radius="{{ block.settings.radius }}"
  style="margin:{{ block.settings.spacing }}px 0;"
  {{ block.shopify_attributes }}
></div>
<script src="{{ 'rivu-showcase.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Rivu Testimonials",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Style" },
    {
      "type": "select", "id": "style", "label": "Style",
      "options": [
        { "value": "strip", "label": "Rating strip — verdict, stars, scrolling reviews" },
        { "value": "quotes", "label": "Pull quotes — centred, italic" }
      ],
      "default": "strip"
    },
    {
      "type": "select", "id": "star_style", "label": "Star shape",
      "options": [
        { "value": "square", "label": "Solid square" },
        { "value": "star", "label": "Classic star" }
      ],
      "default": "square"
    },

    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to hide the heading." },
    { "type": "text", "id": "verdict_text", "label": "Verdict word", "info": "Leave empty and Rivu picks one from your rating — Excellent, Great, Good." },
    { "type": "text", "id": "count_text", "label": "Text under the stars", "info": "Leave empty for \"Based on 12 reviews\". You can use {average}, {total} and {count}." },
    { "type": "text", "id": "caption", "label": "Caption below", "info": "For example: Showing our favourite reviews." },
    { "type": "checkbox", "id": "underline_count", "label": "Underline the review count", "default": true },
    { "type": "checkbox", "id": "show_verified", "label": "Show \"Verified\" badge", "default": false },

    { "type": "header", "content": "Reviews" },
    { "type": "range", "id": "limit", "label": "Reviews to show", "min": 3, "max": 30, "step": 1, "default": 12 },
    { "type": "range", "id": "min_rating", "label": "Minimum rating", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "clamp_lines", "label": "Lines of review text", "min": 1, "max": 8, "step": 1, "default": 3, "info": "Longer reviews are trimmed so every column is the same height." },
    { "type": "range", "id": "compact_width", "label": "Width of each review", "min": 180, "max": 400, "step": 10, "default": 250, "unit": "px" },

    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show previous / next arrows", "default": true },
    {
      "type": "select", "id": "arrow_style", "label": "Arrow style",
      "options": [
        { "value": "subtle", "label": "Subtle — thin outline" },
        { "value": "solid", "label": "Solid — filled with shadow" }
      ],
      "default": "subtle"
    },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 40, "default": 1200, "unit": "px", "info": "0 = full width of your theme." },
    { "type": "range", "id": "spacing", "label": "Space above and below", "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "default": 10, "unit": "px" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#1a1a1a" },
    { "type": "color", "id": "card_bg", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a1a1a" }
  ]
}
{% endschema %}
