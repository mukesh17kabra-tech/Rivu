{% comment %}
  Rivu Trust Badge — your store's overall rating and review count.
  Add via: Customize -> Add section -> Apps -> Rivu Trust Badge
  Works on any page. Not product-specific — for one product's stars, use
  Rivu Rating Badge on a product page instead.
{% endcomment %}

<div
  data-rivu-showcase
  data-shop="{{ shop.permanent_domain }}"
  data-api-base="https://rivu-one.vercel.app"
  data-layout="trust"
  data-badge-scale="{{ block.settings.size }}"
  data-badge-text="{{ block.settings.custom_text | escape }}"
  data-badge-inline="{% if block.settings.one_line %}true{% else %}false{% endif %}"
  {% if block.settings.full_width %}data-max-width="{{ block.settings.max_width }}"{% endif %}
  data-star-color="{{ block.settings.star_color }}"
  data-card-bg="{{ block.settings.card_bg }}"
  data-text-color="{{ block.settings.text_color }}"
  data-radius="{{ block.settings.radius }}"
  style="margin:{{ block.settings.spacing }}px 0;text-align:{{ block.settings.alignment }};"
  {{ block.shopify_attributes }}
></div>
<script src="{{ 'rivu-showcase.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Rivu Trust Badge",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Text" },
    {
      "type": "text", "id": "custom_text", "label": "Text beside the stars",
      "default": "",
      "info": "Leave empty for \"2 reviews\". You can use {average}, {total} and {count} — for example: Rated {average}/5 by {total} happy customers."
    },
    { "type": "checkbox", "id": "one_line", "label": "Show everything on one line", "default": false, "info": "Best for a header or beside an Add to cart button." },

    { "type": "header", "content": "Size and position" },
    { "type": "range", "id": "size", "label": "Size", "min": 0.8, "max": 2.5, "step": 0.1, "default": 1.4, "info": "Scales the whole badge. 1.0 is the original size." },
    {
      "type": "select", "id": "alignment", "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "full_width", "label": "Stretch to a fixed width", "default": false, "info": "Off = the badge hugs its contents." },
    { "type": "range", "id": "max_width", "label": "Width when stretched", "min": 200, "max": 1200, "step": 20, "default": 420, "unit": "px" },
    { "type": "range", "id": "spacing", "label": "Space above and below", "min": 0, "max": 100, "step": 4, "default": 20, "unit": "px" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "default": 10, "unit": "px" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#f5b400" },
    { "type": "color", "id": "card_bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a1a1a" }
  ]
}
{% endschema %}
